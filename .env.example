# ==========================================
# TableFlow Environment Variables (Example)
# Copy to .env and fill with strong random values.
# NEVER commit .env or real secrets to Git.
# ==========================================

# Server
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# MySQL (use a least-privilege DB user for the app runtime)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tableflow
DB_USER=tableflow_app
DB_PASSWORD=replace_with_strong_db_password
DB_SSL=false

# JWT & Session Secrets (generate >= 32 random bytes each)
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_at_least_32_char_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_char_random_hex_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECRET=replace_with_at_least_32_char_random_hex_cookie_secret
GUEST_SESSION_TTL_MINUTES=120

# Tax / Billing (in basis points: 250 = 2.5%)
CGST_BPS=250
SGST_BPS=250

# Razorpay (Test Mode Keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# SMTP Email Receipts (optional in dev; falls back to JSON logger transport if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TableFlow Receipts <no-reply@tableflow.local>

# Client (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
