# =====================================================================
# TableFlow Environment Variables (Vercel + Neon/Supabase Postgres)
# Copy to .env.local for local dev. NEVER commit .env or .env.local.
# =====================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Postgres (Neon or Supabase pooled URL + direct URL for Prisma migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tableflow?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/tableflow?schema=public

# Auth.js & Session Secrets (generate >= 32 random bytes each)
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace_with_at_least_32_char_random_hex_auth_secret
GUEST_COOKIE_SECRET=replace_with_at_least_32_char_random_hex_guest_cookie_secret
GUEST_SESSION_TTL_MINUTES=120

# Tax / Billing (basis points: 250 = 2.5%)
CGST_BPS=250
SGST_BPS=250

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Realtime (Live updates across guest, staff, kitchen)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_key_id

# Resend (Email GST Receipts)
RESEND_API_KEY=
RESEND_FROM=TableFlow Receipts <onboarding@resend.dev>
